{
  "name": "@wfengine/nodes-base",
  "version": "0.1.0",
  "description": "Built-in wfengine nodes (HTTP, webhook, cron, noop)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config-schemas": {
      "types": "./dist/config-schemas.d.ts",
      "import": "./dist/config-schemas.js"
    },
    "./utils/validation": {
      "types": "./dist/utils/validation.d.ts",
      "import": "./dist/utils/validation.js"
    },
    "./utils/validation.js": {
      "types": "./dist/utils/validation.d.ts",
      "import": "./dist/utils/validation.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@slack/web-api": "^7.8.0",
    "@wfengine/core": "^0.1.0",
    "@wfengine/shared": "^0.1.0",
    "imapflow": "^1.0.186",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "resend": "^6.12.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
