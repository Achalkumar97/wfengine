{
  "name": "@wfengine/ui",
  "version": "0.1.0",
  "description": "React Flow workflow canvas for wfengine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": ["./dist/WorkflowCanvas.js", "./dist/reactFlowControlsFix.css"],
  "scripts": {
    "build": "tsc && cp src/reactFlowControlsFix.css dist/reactFlowControlsFix.css",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@wfengine/shared": "^0.1.0",
    "clsx": "^2.1.1",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
