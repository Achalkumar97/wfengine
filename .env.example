# Copy to .env for local server development
# Compose maps Postgres to host port 5433 (see infra/docker-compose.yml). Use :5432 only if nothing else listens there.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/wfengine"
# Compose maps Redis to host port 6380 (see infra/docker-compose.yml).
REDIS_URL="redis://localhost:6380"
PORT=30001
# GitHub PAT for private repos — shared by all GitHub nodes when not set per-node (Analyze does not echo token downstream).
# WFENGINE_GITHUB_TOKEN="ghp_..."
# Optional: protect API routes (webhooks /health bypass per server auth.ts)
# API_KEY="change-me"
