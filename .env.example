# =============================================================================
# wfengine — single template for local setup.
#
#   cp .env.example .env          # repo root (server, worker, Python if you export from here)
#
# Studio (Vite) only reads env files under apps/studio/. Copy the "Studio" block below
# into apps/studio/.env, or merge those VITE_* lines into repo-root .env and symlink —
# simplest is: copy VITE_* lines to apps/studio/.env by hand.
# =============================================================================

# --- Database & queue (Docker Compose: infra/docker-compose.yml maps Postgres 5433, Redis 6380) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/wfengine"
REDIS_URL="redis://localhost:6380"
PORT=30001

# GitHub PAT for private repos — shared when not set per-node on GitHub nodes.
# WFENGINE_GITHUB_TOKEN="ghp_..."

# Optional: protect API routes (webhooks /health bypass — see apps/server auth.ts)
# API_KEY="change-me"

# --- HTTP Request node: optional base for relative paths (e.g. url "/v1/forecast?..." on the canvas) ---
# WFENGINE_HTTP_BASE_URL="https://api.open-meteo.com"

# --- LLM nodes (@wfengine/nodes-agents) — server/worker load repo-root .env ---
# Primary OpenAI (or any OpenAI-compatible URL):
# WFENGINE_OPENAI_API_KEY="sk-..."
# OPENAI_API_KEY="sk-..."
# WFENGINE_OPENAI_BASE_URL="https://api.openai.com/v1"

# Direct Ollama as the only backend (set base + dummy key):
# WFENGINE_OPENAI_BASE_URL="http://127.0.0.1:11434/v1"
# WFENGINE_OPENAI_API_KEY="ollama"

# Fallback when OPENAI_API_KEY is unset: same vars as Python — agent nodes use Ollama automatically.
# WFENGINE_OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
# OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
# OLLAMA_MODEL="llama3.2"
# WFENGINE_OLLAMA_MODEL="llama3.2"

# --- Python: bridge module on PYTHONPATH (wfengine python_autogen runtime) ---
# PYTHONPATH="/absolute/path/to/workflow-engine-sdk/examples/python-autogen-bridge"

# --- Python: wfengine_llm client (examples/python-autogen-bridge) ---
# Same process env as below — export from repo-root .env or load this file in scripts.
# Omit OPENAI_API_KEY to use only Ollama.
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"
# OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
# OLLAMA_MODEL="llama3.2"
# OLLAMA_API_KEY="ollama"

# -----------------------------------------------------------------------------
# Studio — copy these lines into apps/studio/.env (Vite exposes only VITE_* to the browser)
# -----------------------------------------------------------------------------
# VITE_WFENGINE_API=http://localhost:30001
# Leave empty to use dev proxy for /runs and /health (see apps/studio/vite.config.ts).
# Optional override when proxy target differs from default 30001 (otherwise same port as
# VITE_WFENGINE_API is used automatically in apps/studio/vite.config.ts).
# VITE_WFENGINE_DEV_API_PORT=30001
# VITE_WFENGINE_API_KEY=
