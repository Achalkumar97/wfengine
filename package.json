{
  "name": "workflow-engine-sdk",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": ["packages/*", "apps/*", "examples/*"],
  "scripts": {
    "build": "turbo run build",
    "build:railway": "find packages apps -name tsconfig.tsbuildinfo -delete && turbo run build",
    "test": "turbo run test",
    "example": "npm run demo -w examples/programmatic",
    "db:generate": "npm run db:generate -w @wfengine/server",
    "db:migrate": "npm run db:migrate -w @wfengine/server",
    "dev:server": "npm run dev -w @wfengine/server",
    "dev:studio": "npm run dev -w examples-studio",
    "start:api": "npm run start -w @wfengine/server",
    "start:worker": "npm run start:worker -w @wfengine/server",
    "start:combined": "npm run start:combined -w @wfengine/server",
    "start:studio": "node apps/studio/scripts/write-runtime-config.mjs && npm run preview -w examples-studio -- --host 0.0.0.0 --port ${PORT:-4173}"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
